{
  "docs": {
    "prose": [
      "docs/*.md",
      "ucode/*.md"
    ],
    "headers": [
      "*.h",
      "*/include/*.h"
    ],
    "exclude": [
      "docs/coverage.md"
    ]
  },
  "build_tags": {
    "root/builds/": "path component after root/builds/",
    "default": "installed"
  },
  "groups": [
    {
      "name": "kernel-ip30",
      "role": "board",
      "arch": "IP30",
      "scan": [
        "mmio",
        "tokens"
      ],
      "glob": [
        "root/usr/cpu/sysgen/IP30boot/odyssey.a",
        "root/builds/*/usr/cpu/sysgen/IP30boot/odyssey.a",
        "root/usr/cpu/sysgen/IP30boot/tport.a"
      ]
    },
    {
      "name": "kernel-ip35",
      "role": "board",
      "arch": "IP35",
      "scan": [
        "mmio",
        "tokens"
      ],
      "glob": [
        "root/usr/cpu/sysgen/IP35boot/odyssey.a",
        "root/usr/cpu/sysgen/IP35boot/tport.a"
      ]
    },
    {
      "name": "kernel-shared-ip30",
      "role": "shared",
      "arch": "IP30",
      "scan": [],
      "glob": [
        "root/usr/cpu/sysgen/IP30boot/gfx.o",
        "root/usr/cpu/sysgen/IP30boot/gfxs.a",
        "root/usr/cpu/sysgen/IP30boot/gfxstubs.a",
        "root/usr/cpu/sysgen/IP30boot/rrm.o",
        "root/usr/cpu/sysgen/IP30boot/kernel.o",
        "root/usr/cpu/sysgen/IP30boot/odysseystubs.a"
      ]
    },
    {
      "name": "kernel-shared-ip35",
      "role": "shared",
      "arch": "IP35",
      "scan": [],
      "glob": [
        "root/usr/cpu/sysgen/IP35boot/gfx.o",
        "root/usr/cpu/sysgen/IP35boot/gfxs.a",
        "root/usr/cpu/sysgen/IP35boot/gfxstubs.a",
        "root/usr/cpu/sysgen/IP35boot/rrm.o",
        "root/usr/cpu/sysgen/IP35boot/kernel.o",
        "root/usr/cpu/sysgen/IP35boot/odysseystubs.a"
      ]
    },
    {
      "name": "libglcore-ip30",
      "role": "board",
      "arch": "IP30",
      "scan": [
        "tokens",
        "ioctl"
      ],
      "glob": [
        "root/usr/gfx/arch/IP30ODSY*/libGLcore.so",
        "root/builds/*/usr/gfx/arch/IP30ODSY*/libGLcore.so"
      ]
    },
    {
      "name": "libglcore-ip35",
      "role": "board",
      "arch": "IP35",
      "scan": [
        "tokens",
        "ioctl"
      ],
      "glob": [
        "root/usr/gfx/arch/IP35ODSY*/libGLcore.so"
      ]
    },
    {
      "name": "libgl-ip30",
      "role": "board",
      "arch": "IP30",
      "scan": [],
      "glob": [
        "root/usr/gfx/arch/IP30ODSY*/libGL.so",
        "root/builds/*/usr/gfx/arch/IP30ODSY*/libGL.so"
      ]
    },
    {
      "name": "libgl-ip35",
      "role": "board",
      "arch": "IP35",
      "scan": [],
      "glob": [
        "root/usr/gfx/arch/IP35ODSY*/libGL.so"
      ]
    },
    {
      "name": "irisgl",
      "role": "shared",
      "arch": "IP30,IP35",
      "scan": [],
      "glob": [
        "root/usr/gfx/arch/IGLOO/libgl.so",
        "root/usr/gfx/arch/IGLOO32/libgl.so",
        "root/usr/lib32/libfm.so"
      ]
    },
    {
      "name": "x-module",
      "role": "board",
      "arch": "IP30,IP35",
      "scan": [
        "tokens",
        "ioctl"
      ],
      "glob": [
        "root/usr/lib/X11/dyDDX/odyssey.so"
      ]
    },
    {
      "name": "x-shared",
      "role": "shared",
      "arch": "IP30,IP35",
      "scan": [],
      "glob": [
        "root/usr/lib/X11/dyDDX/glx.so",
        "root/usr/gfx/arch/GENERIC/Xsgi"
      ]
    },
    {
      "name": "gfx-tools",
      "role": "shared",
      "arch": "IP30,IP35",
      "scan": [
        "ioctl"
      ],
      "glob": [
        "root/usr/gfx/gfxinit",
        "root/usr/gfx/gfxinfo",
        "root/usr/gfx/setmon",
        "root/usr/gfx/dmconf",
        "root/usr/gfx/sgcombine",
        "root/usr/gfx/gfxtopology",
        "root/usr/bin/X11/xsetmon"
      ]
    },
    {
      "name": "diag",
      "role": "shared",
      "arch": "IP30",
      "scan": [],
      "glob": [
        "root/usr/diags/compositor/bin/sting",
        "root/usr/gfx/STINGRAY/bin/cmp_flash",
        "root/usr/gfx/STINGRAY/bin/cmp_flash_all"
      ]
    },
    {
      "name": "firmware",
      "role": "shared",
      "arch": "IP30,IP35",
      "scan": [],
      "glob": [
        "root/usr/cpu/firmware/IP30prom.bin",
        "root/usr/cpu/firmware/ip35prom.img"
      ],
      "string_names": "\\bodsy\\w{3,}|\\bOdsy\\w{3,}"
    },
    {
      "name": "ucode-data",
      "role": "board",
      "arch": "IP30,IP35",
      "scan": [],
      "glob": [
        "root/usr/gfx/ucode/ODSY/buzz_xform.bin",
        "root/usr/gfx/ucode/ODSY-kernel/*.bin",
        "root/usr/gfx/ucode/vfc/rules/VPro_*.def"
      ]
    },
    {
      "name": "ide",
      "role": "board",
      "arch": "IP30",
      "scan": [],
      "string_names": "\\bodsy\\w{3,}|\\bOdsy\\w{3,}",
      "glob": [
        "root/sbin/stand/ide.IP30"
      ]
    }
  ],
  "mmio": {
    "base_loads": [
      {
        "mnemonics": [
          "ld",
          "lw"
        ],
        "offset": 824,
        "tag": "board"
      }
    ],
    "display_fifo_offset": "0x400000",
    "display_header_types": [
      3,
      7
    ],
    "readback_window": {
      "base": "0x220000",
      "size": "0x20000",
      "stride": 8
    },
    "gp_literal_bias": 30720
  },
  "ioctl_tables": [
    {
      "name": "private",
      "arch": "IP30",
      "archive": "root/usr/cpu/sysgen/IP30boot/odyssey.a",
      "member": "odsy.o",
      "section": ".data",
      "start": "0xe0",
      "stride": 8,
      "count": 53,
      "base": "0x6f640000",
      "field": 0,
      "strip": "gfP_Odsy"
    },
    {
      "name": "private",
      "arch": "IP35",
      "archive": "root/usr/cpu/sysgen/IP35boot/odyssey.a",
      "member": "odsy.o",
      "section": ".data",
      "start": "0xe0",
      "stride": 8,
      "count": 53,
      "base": "0x6f640000",
      "field": 0,
      "strip": "gfP_Odsy"
    },
    {
      "name": "resource-manager",
      "arch": "IP30",
      "archive": "root/usr/cpu/sysgen/IP30boot/rrm.o",
      "member": "",
      "section": ".data",
      "prefix": "RRM_",
      "base": 1000,
      "strip": "",
      "start": "auto",
      "stride": 24,
      "count": 100,
      "field": 0
    },
    {
      "name": "resource-manager",
      "arch": "IP35",
      "archive": "root/usr/cpu/sysgen/IP35boot/rrm.o",
      "member": "",
      "section": ".data",
      "prefix": "RRM_",
      "base": 1000,
      "strip": "",
      "start": "auto",
      "stride": 24,
      "count": 100,
      "field": 0
    }
  ],
  "ucode": [
    {
      "path": "root/usr/gfx/ucode/ODSY/buzz_xform.bin",
      "format": "buzz",
      "kernel_copy": false
    },
    {
      "path": "root/usr/gfx/ucode/ODSY-kernel/buzz_ucode_ip30.bin",
      "format": "buzz",
      "kernel_copy": true
    },
    {
      "path": "root/usr/gfx/ucode/ODSY-kernel/buzz_ucode_ip35.bin",
      "format": "buzz",
      "kernel_copy": true
    }
  ],
  "ucode_entries_module": "buzz_ucode_disasm"
}
